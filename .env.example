# ===== LLM（AI 问答）=====
# 本地开发可用内网 mify：http://model.mify.ai.srv/v1/
LLM_BASE_URL=http://model.mify.ai.srv/v1/
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek/deepseek-v4-flash

# ===== 官方数据源（稳定数据，核心）=====

# 鲸准 MCP（一级市场创投数据：融资事件/创业公司/团队背景/行业）
# 商务洽谈获取：https://www.jingdata.com/data-service/mcp/
JINGDATA_MCP_URL=
JINGDATA_TOKEN=

# 企查查 MCP（工商 + 高管 + 官网，注册即领 500 积分）
# 登录 https://agent.qcc.com 后在「接入指南/获取 API Key」拿
QCC_API_KEY=
